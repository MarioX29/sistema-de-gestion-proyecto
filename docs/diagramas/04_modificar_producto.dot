n [shape=parallelogram, label="Mostrar modificacion correcta"];
z [shape=ellipse, label="Volver a productos"];
a -> b [label=""];
b -> c [label="No"];
c -> z [label=""];
b -> d [label="Si"];
d -> e [label=""];
e -> f [label="No"];
f -> z [label=""];
e -> g [label="Si"];
g -> h [label=""];
h -> i [label=""];
i -> j [label="No"];
