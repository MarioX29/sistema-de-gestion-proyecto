digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.5", label="Promedios por periodo", labelloc=t, fontsize=16];
node [fontname="DejaVu Sans", fontsize=11, margin="0.14,0.09"];
edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
a [shape=ellipse, label="Inicio"];
b [shape=parallelogram, label="Leer fecha inicial; Enter\ncancela"];
c [shape=diamond, label="Fecha vacia?"];
d [shape=diamond, label="Formato y calendario validos?"];
e [shape=parallelogram, label="Avisar fecha invalida"];
f [shape=parallelogram, label="Leer fecha final; Enter\ncancela"];
g [shape=diamond, label="Fecha final vacia?"];
h [shape=diamond, label="Final valida y no anterior?"];
i [shape=parallelogram, label="Avisar error de fecha final"];
j [shape=box, label="Recorrer ventas y seleccionar\nfechas entre inicio y final"];
k [shape=box, label="Sumar ingresos; dias =\ndiferencia + 1"];
l [shape=diamond, label="Ingresos finitos?"];
m [shape=parallelogram, label="Avisar importe fuera de rango"];
n [shape=box, label="Calcular cantidad/dias e\ningresos/dias"];
o [shape=parallelogram, label="Mostrar ventas, dias, ingresos\ny promedios"];
p [shape=parallelogram, label="Mostrar reporte cancelado"];
z [shape=ellipse, label="Volver a reportes"];
a -> b [label=""];
b -> c [label=""];
c -> p [label="Si"];
c -> d [label="No"];
d -> e [label="No"];
e -> b [label=""];
d -> f [label="Si"];
f -> g [label=""];
g -> p [label="Si"];
g -> h [label="No"];
h -> i [label="No"];
i -> f [label=""];
h -> j [label="Si"];
j -> k [label=""];
k -> l [label=""];
l -> m [label="No"];
m -> z [label=""];
l -> n [label="Si"];
n -> o [label=""];
o -> z [label=""];
p -> z [label=""];
}
