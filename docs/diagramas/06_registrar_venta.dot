u [shape=diamond, label="Respuesta S?"];
v [shape=diamond, label="Respuesta N?"];
w [shape=parallelogram, label="Avisar respuesta invalida"];
x [shape=box, label="Asignar numero y fecha;\ndescontar stock; agregar venta\ny movimientos"];
y [shape=parallelogram, label="Mostrar numero de venta"];
z [shape=ellipse, label="Volver al principal"];
