l [shape=diamond, label="Respuesta N?"];
m [shape=parallelogram, label="Avisar cancelacion"];
n [shape=parallelogram, label="Avisar respuesta invalida"];
z [shape=ellipse, label="Volver a productos"];
a -> b [label=""];
